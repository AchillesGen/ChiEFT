(* ---------------------------------------------------------- form factors *)
(*  Each entry names a function the event generator must provide.  The        *)
(*  argument is written for the exported (all-outgoing) leg order:            *)
(*      -P(-9,n)**2  = Q^2 of the gauge boson on leg n                        *)
(*      +P(-9,n)**2  = invariant mass squared of the Delta on leg n           *)
(*  FeynRules does not relabel these strings, so the leg numbers matter.      *)
M$FormFactors = {

    FF1PA == {
        Particles        -> {Protonbar, Proton, A},
        ComplexParameter -> False,
        Value            -> "F1p(-P(-1,3)**2)",
        ParameterName    -> FF1PA
