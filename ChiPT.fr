(* ****************************************************************************** *)
(*  ChiPT.fr -- chiral pion / nucleon / Delta(1232) model for FeynRules            *)
(*                                                                                *)
(*  Pions, nucleons and the Delta(1232) coupled to the photon, W and Z through    *)
(*  one chiral covariant derivative, so electromagnetic and weak currents come    *)
(*  from the same Lagrangian.  The pi-N-Delta and gamma-N-Delta couplings are     *)
(*  the gauge-invariant (Pascalutsa) ones of Fernandez-Ramirez, Moya de Guerra    *)
(*  and Udias, nucl-th/0509020.                                                   *)
(*                                                                                *)
(*  Use with FeynRules (see ExportUFO.nb):                                        *)
(*      LoadModel["ChiPT.fr"];                                                    *)
(*      ChiPTClearCache[];        (* required, see "Cache control" below *)       *)
(*      WriteUFO[LTotal, AddDecays -> False, FlavorExpand -> True,                *)
(*               Output -> "ChiPT_UFO", MaxParticles -> 4];                       *)
(*                                                                                *)
(*  Form factors are attached to the vertices as UFO form factors.  Their         *)
(*  functions (F1p, FW1, FDeltaLam, ...) are supplied by the event generator,     *)
(*  see sherpa/FormFactors.C.                                                     *)
(*                                                                                *)
(*  Pions, nucleons and Delta all use one chiral convention, U -> R U L^+        *)
(*  (Gasser-Leutwyler), see "Chiral building blocks" below.                       *)
(* ****************************************************************************** *)

M$ModelName = "ChiPT";

M$Information = {
  Authors      -> {"Z. Graham-Jones", "M. Hoppe", "J. Isaacson", "S. W. Li", "M. Toman"},
  Version      -> "1.0",
  Date         -> "2026-10-25",
  Institutions -> {"IPPP, Durham University", "TUD Dresden University of Technology",
                   "Michigan State University", "University of California, Irvine"},
  Emails       -> {"zara.m.graham-jones@durham.ac.uk", "mareen.hoppe@tu-dresden.de",
                   "isaacs21@msu.edu", "shirley.li@uci.edu", "mtoman@uci.edu"},
  References   -> {"C. Fernandez-Ramirez, E. Moya de Guerra, J. M. Udias, nucl-th/0509020",
                   "Z. Graham-Jones et al., Phenomenological Chiral Perturbation Theory for Neutrino Event Generators, arXiv:<id>"}
};

FeynmanGauge = False;

(* ----------------------------------------------------------- gauge groups *)
M$GaugeGroups = {
  U1Y  == {
    Abelian          -> True,
    CouplingConstant -> g1,
    GaugeBoson       -> B,
    Charge           -> Y
  },
  SU2L == {
    Abelian           -> False,
    CouplingConstant  -> g2,
    GaugeBoson        -> Wi,
    StructureConstant -> Eps,
    Representations   -> {Ta,SU2D},
    Definitions       -> {Ta[a_,b_,c_]->PauliSigma[a,b,c]/2, FSU2L[i_,j_,k_]:> I Eps[i,j,k]}
  }
};

(* ---------------------------------------------------------------- indices *)
IndexRange[Index[SU2W      ]] = Unfold[Range[3]];
IndexRange[Index[SU2D      ]] = Unfold[Range[2]];
IndexRange[Index[Generation]] = Range[3];
IndexRange[Index[IsoSpin   ]] = Unfold[Range[2]];
IndexRange[Index[IsoVector ]] = Unfold[Range[3]];

IndexStyle[SU2W,       j];
IndexStyle[SU2D,       k];
IndexStyle[Generation, f];
IndexStyle[IsoSpin,    s];
IndexStyle[IsoVector,  v];

(* ------------------------------------------------------ interaction orders *)
(*  CHI counts powers of 1/fPi.  It must be nonzero on hadronic vertices,      *)
(*  otherwise Sherpa/Comix silently drops diagrams with purely hadronic         *)
(*  vertices (e.g. the s-channel Delta in gamma p -> pi0 p).                    *)
M$InteractionOrderHierarchy = {
  {QED, 1},
  {QCD, 1},
  {CHI, 1}
};

M$InteractionOrderLimit = {
  {QED, 99},
  {QCD, 0},
  {CHI, 99}
};

